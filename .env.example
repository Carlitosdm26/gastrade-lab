# Keep credentials private. Copy this file to .env on the Linux host.
PAPERTRADE_PORT=8080
MARKET_POLL_SECONDS=60

# Default: local SQLite database persisted in the Docker volume.
DATABASE_URL=sqlite:////data/papertrade.db

# To use a PostgreSQL database instead, replace DATABASE_URL with:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/papertrade
